# The package for M5's launcher (APPLaunch), on the contract of scripts/pack-deb.sh in CardputerZero/AppBuilder
# (https://github.com/CardputerZero/AppBuilder):
#   path/to/AppBuilder/scripts/pack-deb.sh desktop/cardputer --output-dir desktop/target/dist
# The version is the tree's (tools/current-tree-version.sh): v2026.11.07-9de300 is 2026.11.07+git9de300.
VO_TREE=$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && tools/current-tree-version.sh)
PKG_NAME=vibeoffice
PKG_VERSION=$(echo "$VO_TREE" | sed 's/^v\([0-9.]*\)-\(.*\)$/\1+git\2/')
PKG_REVISION=1
PKG_DESC="VibeOffice Lite: documents, spreadsheets and presentations (.docx, .xlsx, .pptx) on the CardputerZero"
PKG_MAINTAINER="tcchen2026 <264924385+tcchen2026@users.noreply.github.com>"
PKG_HOMEPAGE=https://vibeoffice.work
PKG_DEPENDS="cage, libwebkit2gtk-4.1-0"
APP_NAME="VibeOffice"
APP_EXEC=/usr/share/APPLaunch/bin/vibeoffice
APP_TERMINAL=false
APP_ICON=share/images/vibeoffice.png
